{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=VehiStockDb;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_HERE",
    "Issuer": "VehiStock",
    "Audience": "VehiStockUsers",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },

  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    }
  },

  "Alerts": {
    "ScanIntervalMinutes": 15,
    "LowStockThreshold": 10,
    "NotificationRepeatHours": 24
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "vehistock@gmail.com",
    "SenderPassword": "",
    "EnableSsl": true
  },

  "AllowedHosts": "*"
}